# Copy to .env and fill in. Never commit .env.
# Any OpenAI-compatible endpoint works: OpenRouter, Groq, Gemini's OpenAI endpoint, a local proxy.
BAZAAR_LLM_BASE_URL=https://openrouter.ai/api/v1
BAZAAR_LLM_API_KEY=
BAZAAR_LLM_MODEL=
BAZAAR_LLM_TIMEOUT_S=60
BAZAAR_LLM_MAX_RETRIES=3

# Optional: a separate (ideally stronger) model for the BazaarBench customer simulator.
# Empty values fall back to the BAZAAR_LLM_* settings above.
BAZAAR_SIM_BASE_URL=
BAZAAR_SIM_API_KEY=
BAZAAR_SIM_MODEL=
